+    for (n = 0; n < NFS_CLOCK_CALLERS; ++n, i = (i + 1) % NFS_CLOCK_CALLERS) {
+        if (nfs_clock_caller[i] == caller) { ++nfs_clock_count[i]; return; }
+        if (!nfs_clock_caller[i]) { nfs_clock_caller[i] = caller; nfs_clock_count[i] = 1; return; }
+    }
