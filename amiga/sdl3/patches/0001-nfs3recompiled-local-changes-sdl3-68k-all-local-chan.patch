@@ -540,6 +556,11 @@ typedef unsigned __int128 Uint128;
 #endif
 
 static Uint64 tick_start;
+static unsigned char nfs_fast_preview_ticks;
+void NFS_AmigaUseFastPreviewTicks(int enabled)
+{
+    __atomic_store_n(&nfs_fast_preview_ticks,enabled!=0,__ATOMIC_RELAXED);
