     }
 
     starting_value = (SDL_GetPerformanceCounter() - tick_start);
+#if defined(__mc68040__) && !defined(USE_128BIT_MATH)
+    if (nfs_fpu_ticks())
+        return nfs_double_to_u64(nfs_u64_to_double(starting_value) * (nfs_u64_to_double(tick_numerator_ms) / nfs_u64_to_double(tick_denominator_ms)));
+#endif
