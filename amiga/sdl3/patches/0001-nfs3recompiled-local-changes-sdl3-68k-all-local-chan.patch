+
+/* NFS: the game sets this from -intticks to keep SDL's original integer
+ * conversion; otherwise the counter is scaled on the FPU. */
+int nfs_sdl_int_ticks = 0;
+static int nfs_fpu_ticks(void)
+{
+    return !nfs_sdl_int_ticks;
+}
+
+/* NFS: Uint64 <-> double through two 32-bit halves.  The 68k FPU converts
+ * only signed 32-bit integers; a plain cast of a Uint64 is a libgcc routine
+ * (__floatundidf, __fixunsdfdi) of a hundred instructions, on every tick. */
+static SDL_INLINE double nfs_u64_to_double(Uint64 v)
+{
+    const Uint32 hi = (Uint32)(v >> 32), lo = (Uint32)v;
+    return (double)(Sint32)hi * 4294967296.0 + ((double)(Sint32)(lo ^ 0x80000000u) + 2147483648.0);
+}
+static SDL_INLINE Uint64 nfs_double_to_u64(double d)  /* 0 <= d < 2^63 */
+{
+    const Sint32 hi = (Sint32)(d * (1.0 / 4294967296.0));
+    const double rest = d - (double)hi * 4294967296.0;  /* [0, 2^32) */
+    const Uint32 lo = rest >= 2147483648.0 ? ((Uint32)(Sint32)(rest - 2147483648.0) ^ 0x80000000u) : (Uint32)(Sint32)rest;
+    return ((Uint64)(Uint32)hi << 32) | lo;
+}
+extern void nfs_clock_note(void *caller);
 Uint64 SDL_GetTicksNS(void)
 {
     Uint64 starting_value, value;
+    nfs_clock_note(__builtin_return_address(0));
 
     if (!tick_start) {
         SDL_InitTicks();
     }
 
     starting_value = (SDL_GetPerformanceCounter() - tick_start);
+#if defined(__mc68040__) && !defined(USE_128BIT_MATH)
+    /* NFS: the 64/32 integer divisions (__udivdi3/__umoddi3) were a tenth of
+     * a 68k frame.  The 68060 has no 64-bit DIVU.L, so the counter is scaled
+     * on the FPU instead: a double holds the counter exactly for centuries and
+     * the product is monotonic. */
+    (void)nfs_fast_preview_ticks;
+    if (nfs_fpu_ticks())
+        return nfs_double_to_u64(nfs_u64_to_double(starting_value) * (nfs_u64_to_double(tick_numerator_ns) / nfs_u64_to_double(tick_denominator_ns)));
+#endif
 #ifdef USE_128BIT_MATH
     value = (Uint64)(((Uint128)starting_value * tick_numerator_ns) >> 32);
 #else
@@ -655,15 +711,35 @@ Uint64 SDL_GetTicksNS(void)
     return value;
 }
 
+/* NFS Classic preview-only entry: same epoch and integer conversion as SDL,
+ * with one hardware quotient/remainder operation for each 64/32 division. */
+Uint64 NFS_AmigaGetTicksNSFast(void)
+{
+    nfs_clock_note(__builtin_return_address(0));
+#if defined(__mc68040__) && !defined(USE_128BIT_MATH)
+    if (!tick_start) SDL_InitTicks();
+    if (!tick_denominator_ns) return SDL_GetTicksNS();
+    return nfs_scale_counter(SDL_GetPerformanceCounter()-tick_start,
+                             tick_numerator_ns,tick_denominator_ns);
+#else
+    return SDL_GetTicksNS();
+#endif
+}
+
