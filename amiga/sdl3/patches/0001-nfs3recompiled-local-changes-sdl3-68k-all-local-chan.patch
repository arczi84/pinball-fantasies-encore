+/* The same for SDL_getenv and SDL_GetHint: each takes the environment's or
+ * the hints' locks, Exec semaphores. */
+static void *nfs_env_caller[NFS_CLOCK_CALLERS];
+static unsigned long nfs_env_count[NFS_CLOCK_CALLERS];
+void nfs_env_note(void *caller)
+{
+    unsigned i = ((unsigned long)caller >> 1) % NFS_CLOCK_CALLERS, n;
+    for (n = 0; n < NFS_CLOCK_CALLERS; ++n, i = (i + 1) % NFS_CLOCK_CALLERS) {
+        if (nfs_env_caller[i] == caller) { ++nfs_env_count[i]; return; }
+        if (!nfs_env_caller[i]) { nfs_env_caller[i] = caller; nfs_env_count[i] = 1; return; }
+    }
+}
+unsigned nfs_env_callers(void **callers, unsigned long *counts, unsigned max, int reset)
+{
+    unsigned i, n = 0;
+    for (i = 0; i < NFS_CLOCK_CALLERS && n < max; ++i)
+        if (nfs_env_caller[i]) { callers[n] = nfs_env_caller[i]; counts[n++] = nfs_env_count[i]; }
+    if (reset)
+        for (i = 0; i < NFS_CLOCK_CALLERS; ++i) { nfs_env_caller[i] = 0; nfs_env_count[i] = 0; }
+    return n;
+}
+unsigned nfs_clock_callers(void **callers, unsigned long *counts, unsigned max, int reset)
+{
+    unsigned i, n = 0;
+    for (i = 0; i < NFS_CLOCK_CALLERS && n < max; ++i)
+        if (nfs_clock_caller[i]) { callers[n] = nfs_clock_caller[i]; counts[n++] = nfs_clock_count[i]; }
+    if (reset)
+        for (i = 0; i < NFS_CLOCK_CALLERS; ++i) { nfs_clock_caller[i] = 0; nfs_clock_count[i] = 0; }
+    return n;
+}
