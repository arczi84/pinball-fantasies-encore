+
+/* NFS: the application's own MiniGL fullscreen screen is closed and opened
+ * again at another size (menus at 640x480, a race at its resolution).  Detach
+ * drops the native window before MiniGL closes it, so nothing pumps a dead
+ * window; replace puts the new window and context under the same SDL window. */
+void SDL_OS3_NFS_DetachExternalWindow(SDL_Window *window)
+{
+    SDL_WindowData *d = window ? window->internal : NULL;
+    if (!d || !d->external_window) return;
+    d->syswin = NULL;
+    d->screen = NULL;
+    d->gl_context = NULL;
+}
+
+void SDL_OS3_NFS_ReplaceExternalWindow(SDL_Window *window, struct Window *w, void *context)
+{
+    SDL_WindowData *d = window ? window->internal : NULL;
+    if (!d || !d->external_window || !w) return;
+    d->syswin = w;
+    d->screen = w->WScreen;
+    d->gl_context = (SDL_GLContext)context;
+    d->gl_width = w->Width - w->BorderLeft - w->BorderRight;
+    d->gl_height = w->Height - w->BorderTop - w->BorderBottom;
+    d->pump_external = true;
+    ModifyIDCMP(w, OS3_IDCMP_FULLSCREEN);
+    ActivateWindow(w);
+    window->x = w->LeftEdge;
+    window->y = w->TopEdge;
+    window->w = d->gl_width;
+    window->h = d->gl_height;
+    SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_RESIZED, window->w, window->h);
+}
