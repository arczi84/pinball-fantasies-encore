diff --git a/SDL3/amiga-port-include/port/counter_scale.h b/SDL3/amiga-port-include/port/counter_scale.h
new file mode 100644
index 0000000..d22f653
--- /dev/null
+++ b/SDL3/amiga-port-include/port/counter_scale.h
@@ -0,0 +1,30 @@
+#ifndef NFS_COUNTER_SCALE_H
+#define NFS_COUNTER_SCALE_H
+#include <stdint.h>
+typedef struct NfsDiv32 { uint64_t quotient; uint32_t remainder; } NfsDiv32;
+/* Nonzero 32-bit denominator; preserve the full 64-bit counter. */
+static inline NfsDiv32 nfs_divmod_u64_u32(uint64_t value,uint32_t denominator)
+{
+    NfsDiv32 result;
+#if defined(__mc68040__) && defined(__GNUC__)
+    uint32_t high=(uint32_t)(value>>32),low=(uint32_t)value,upper=0;
+    if(high>=denominator){
+        uint32_t rem=0;
+        upper=high;
+        __asm__("divu.l %2,%1:%0":"+&d"(upper),"+&d"(rem):"d"(denominator):"cc");
+        high=rem;
+    }
+    __asm__("divu.l %2,%1:%0":"+&d"(low),"+&d"(high):"d"(denominator):"cc");
+    result.quotient=((uint64_t)upper<<32)|low;result.remainder=high;
+#else
+    result.quotient=value/denominator;result.remainder=(uint32_t)(value%denominator);
+#endif
+    return result;
+}
+static inline uint64_t nfs_scale_counter(uint64_t value,uint32_t numerator,uint32_t denominator)
+{
+    const NfsDiv32 parts=nfs_divmod_u64_u32(value,denominator);
+    const NfsDiv32 fraction=nfs_divmod_u64_u32((uint64_t)parts.remainder*numerator,denominator);
+    return parts.quotient*numerator+fraction.quotient;
+}
+#endif
