-REL=$(patsubst ./%,%,$(SOURCES:.c=.o))
-CLOBJ=$(addprefix build/clib2/,$(REL))
-LNOBJ=$(addprefix build/libnix/,$(REL))
-
-TESTLIB_SOURCES=$(wildcard ./src/test/*.c)
-TESTLIB_REL=$(patsubst ./%,%,$(TESTLIB_SOURCES:.c=.o))
